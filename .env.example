# Nomes das configurações do Clube HA Gourmet. NUNCA coloque valores reais neste arquivo nem no repositório.
#
# O site é estático (Hostinger): não há variáveis de ambiente no navegador. Os valores PÚBLICOS ficam em config.js:
#   - URL do projeto Supabase e chave publicável (sb_publishable_...), já usadas pelo app de gestão.
# Chave publicável do Stripe: não é usada (o Checkout e o Portal são hospedados pelo Stripe).
#
# Os SEGREDOS abaixo são cadastrados como Secrets das Edge Functions, por ambiente (projeto de homologação e de
# produção separados), com:  supabase secrets set --env-file ./supabase/functions/.env   (arquivo fora do git)
# ou pelo painel: Project Settings > Edge Functions > Secrets.

# URL pública do site (sem barra no final). Usada nas URLs de retorno do Checkout e do Portal.
CLUBE_APP_URL=https://seu-dominio.com.br
# Origens autorizadas a chamar as funções pelo navegador (CORS), separadas por vírgula.
CLUBE_ALLOWED_ORIGINS=https://seu-dominio.com.br,https://www.seu-dominio.com.br

# Stripe (modo de teste em homologação: sk_test_... / produção: sk_live_... somente na virada combinada).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HA_ASSINATURA=
STRIPE_PRICE_HA_CLUB=
STRIPE_PORTAL_CONFIG_ID=

# Segredo compartilhado entre o Supabase Cron (Vault: clube_jobs_secret) e a função clube-jobs. Gere um valor longo
# e aleatório, por exemplo: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
CLUBE_JOBS_SECRET=

# Opcional: chave secreta nova do Supabase (sb_secret_...) só para o servidor. Se vazia, as funções usam a
# SUPABASE_SERVICE_ROLE_KEY que o Supabase injeta automaticamente (junto com SUPABASE_URL).
CLUBE_SUPABASE_SECRET_KEY=

# ---- Usadas só no seu computador (CLI), não nas funções ----
# Conexão de banco para migrations (supabase db push). Pegue em Project Settings > Database.
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Script scripts/stripe-configurar.mjs:
# CLUBE_WEBHOOK_URL=https://<ref>.supabase.co/functions/v1/clube-stripe-webhook
#
# E-mail transacional (confirmação de cadastro e recuperação de senha) é configurado no painel do Supabase:
# Authentication > Emails > SMTP Settings (host, porta, usuário, senha, remetente). Não vai em arquivo do projeto.
